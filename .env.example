# Local development settings for the API. Copy to .env at the repository root.
CARETRACE_ENVIRONMENT=development
CARETRACE_ALLOWED_HOSTS=["localhost","127.0.0.1"]
CARETRACE_ALLOWED_ORIGINS=[]
CARETRACE_MAX_REQUEST_BYTES=1048576
# Optional fictional IPAC citation demo for development and test.
# CARETRACE_ENABLE_SYNTHETIC_IPAC=true
# Optional local database URL. Create the ignored data directory before using this example.
# CARETRACE_DATABASE_URL=sqlite+pysqlite:///data/caretrace.db
